pipeline {
    agent any

    environment {
        REPO_URL = 'https://github.com/hansleolml/clasedmc02.git'
        IMAGE_NAME = 'hansleolml/jenkinsdocker'
    }

    stages {
        stage('Checkout') {
            steps {
                echo '=== Etapa: Checkout ==='
                echo 'Clonando https://github.com/hansleolml/clasedmc02'
                sh '''
                    rm -rf clasedmc02
                    git clone --depth 1 --branch master "${REPO_URL}" clasedmc02
                '''
                script {
                    env.COMMIT = sh(script: 'git -C clasedmc02 rev-parse HEAD', returnStdout: true).trim()
                }
                echo "Repositorio clonado. Commit: ${env.COMMIT}"
            }
        }

        stage('Build Image') {
            steps {
                echo '=== Etapa: Build de imagen Docker ==='
                dir('clasedmc02/DMC_CLASE_03/Java_hello') {
                    sh 'docker build -t "${IMAGE_NAME}:${COMMIT}" .'
                }
                echo "Imagen ${env.IMAGE_NAME}:${env.COMMIT} creada"
            }
        }

        stage('Push Docker Hub') {
            steps {
                echo '=== Etapa: Push a Docker Hub ==='
                sh 'docker push "${IMAGE_NAME}:${COMMIT}"'
                echo "Imagen publicada: ${env.IMAGE_NAME}:${env.COMMIT}"
            }
        }

        stage('Deploy') {
            steps {
                echo '=== Etapa: Deploy ==='
                echo 'Conectando por SSH a adminuser@20.97.4.16'
                withCredentials([sshUserPrivateKey(
                    credentialsId: 'llaveprivada',
                    keyFileVariable: 'SSH_KEY'
                )]) {
                    sh '''
                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            -o UserKnownHostsFile=/dev/null \
                            adminuser@20.97.4.16 bash -s <<EOF
set -e
docker pull ${IMAGE_NAME}:${COMMIT}
docker rm -f jenkinsdocker || true
docker run -d --name jenkinsdocker --restart unless-stopped -p 443:8080 ${IMAGE_NAME}:${COMMIT}
EOF
                    '''
                }
                echo "Contenedor jenkinsdocker publicado en http://20.97.4.16:8080"
            }
        }
    }

    post {
        success {
            echo '=== Pipeline completado: imagen publicada y desplegada ==='
        }
        failure {
            echo '=== Pipeline fallo ==='
            echo 'Revisar logs para mas detalles'
        }
        always {
            sh 'rm -rf clasedmc02 || true'
            echo '=== Pipeline finalizado ==='
        }
    }
}
