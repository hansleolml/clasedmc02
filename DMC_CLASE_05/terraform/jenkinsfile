pipeline {
    agent any

    environment {
        REPO_URL = 'https://github.com/hansleolml/clasedmc02.git'
        IMAGE_NAME = 'hansleolml/jenkinsdocker'
    }

    stages {
        stage('Checkout') {
            steps {
                echo '=== Etapa: Checkout ==='
                echo 'Clonando https://github.com/hansleolml/clasedmc02'
                sh '''
                    rm -rf clasedmc02
                    git clone --depth 1 --branch master "${REPO_URL}" clasedmc02
                '''
                script {
                    env.COMMIT = sh(script: 'git -C clasedmc02 rev-parse HEAD', returnStdout: true).trim()
                }
                echo "Repositorio clonado. Commit: ${env.COMMIT}"
            }
        }

        stage('Build Image') {
            steps {
                echo '=== Etapa: Build de imagen Docker ==='
                dir('clasedmc02/DMC_CLASE_03/Java_hello') {
                    sh 'docker build -t "${IMAGE_NAME}:${COMMIT}" .'
                }
                echo "Imagen ${env.IMAGE_NAME}:${env.COMMIT} creada"
            }
        }

        stage('Push Docker Hub') {
            steps {
                echo '=== Etapa: Push a Docker Hub ==='
                sh 'docker push "${IMAGE_NAME}:${COMMIT}"'
                echo "Imagen publicada: ${env.IMAGE_NAME}:${env.COMMIT}"
            }
        }
    }

    post {
        success {
            echo '=== Pipeline completado: imagen publicada en Docker Hub ==='
        }
        failure {
            echo '=== Pipeline fallo ==='
            echo 'Revisar logs para mas detalles'
        }
        always {
            sh 'rm -rf clasedmc02 || true'
            echo '=== Pipeline finalizado ==='
        }
    }
}
